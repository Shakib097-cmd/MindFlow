# =========================================================================
# MINDFLOW AI — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this template to .env or configure in Google Cloud Secret Manager / Cloudflare Pages.
# NEVER commit real credentials or private keys to source control.
# =========================================================================

# -------------------------------------------------------------------------
# BACKEND & CLOUD RUN ENVIRONMENT VARIABLES
# -------------------------------------------------------------------------
# Node environment ('production' or 'development')
NODE_ENV=production

# Server Port (Google Cloud Run dynamically provides PORT; defaults to 3000)
PORT=3000

# Server-Side Google Gemini AI API Key (Secret Manager compatible, NEVER expose to browser)
GEMINI_API_KEY=

# Firebase Admin Service Account Credentials (for Cloud Run server-side operations)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Allowed CORS Origins (comma-separated list for multi-domain support)
# Example: https://mindworkflow.in,https://mindflow.example.com,https://api.mindflow.example.com
CORS_ORIGINS=https://mindworkflow.in,https://mindflow.example.com,https://api.mindflow.example.com

# Primary Production Domain & Canonical URL
APP_URL=https://mindworkflow.in
SITE_URL=https://mindworkflow.in

# Super Admin Email (Owner override for administration panel)
ADMIN_EMAIL=starcybercafe097@gmail.com

# -------------------------------------------------------------------------
# FRONTEND / CLIENT ENVIRONMENT VARIABLES (Vite / Cloudflare Pages)
# -------------------------------------------------------------------------
# Client-Side Firebase Configuration (Non-sensitive public credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API Backend Base URL (leave empty for same-origin proxy, or specify for separated Cloudflare/Cloud Run architecture)
# Example: https://api.mindflow.example.com
VITE_API_BASE_URL=

# Public Canonical Site URL
VITE_APP_URL=https://mindworkflow.in
